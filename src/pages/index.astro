---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p>Personal website to share my contribution in open source, research and photography.</p>
			<h2>Preprint</h2>
			<p>
				<a href="/publications/entg_preprint/">Genome expansions and regulatory contact entanglement help preserve ancestral metazoan synteny</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
